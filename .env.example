# ---------------------------------------------------------------------------
# Polymarket 5-minute crypto bot
#
# Nothing here is required for paper trading. Copy to .env and edit what you
# want to change. `bot config` prints the effective settings with secrets
# redacted. Full reference: docs/CONFIG.md
# ---------------------------------------------------------------------------

# --- mode ------------------------------------------------------------------
# Live trading needs BOTH of these set, plus credentials below. Each one fails
# closed on its own.
TRADING_MODE=paper
LIVE_CONFIRMATION=false
# Build and sign live orders but never send them. Use this first.
DRY_RUN_LIVE=false

# --- credentials (live only) ----------------------------------------------
# Never commit a real .env. See docs/SETUP.md for deriving the L2 credentials.
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# The address holding the USDC. For a proxy wallet this is NOT your EOA.
# POLYMARKET_FUNDER=0x...
# 0 = EOA, 1 = Magic Link proxy, 2 = Gnosis Safe proxy (usual)
POLYMARKET_SIGNATURE_TYPE=2

# --- markets ---------------------------------------------------------------
ASSETS=BTC,ETH,SOL,XRP,DOGE
MAX_TRACKED_MARKETS=40
DISCOVERY_INTERVAL_SECONDS=20

# --- market quality --------------------------------------------------------
MAX_SPREAD=0.03
MIN_LIQUIDITY_USD=200
MAX_SLIPPAGE=0.02
MIN_SECONDS_REMAINING=20
MAX_SECONDS_REMAINING=270

# --- signal thresholds ----------------------------------------------------
# MIN_EDGE is a floor; the real bar scales up with uncertainty, thin
# liquidity, poor data quality and difficult regimes.
MIN_EDGE=0.025
MIN_CONFIDENCE=0.55
# Edges above this are refused as model error, not sized up.
MAX_PLAUSIBLE_EDGE=0.12

# The single most important setting. Weight on our model vs the market's own
# price. The conservative default trades rarely on purpose. Fit it from your
# own data with pmbot.probability.anchor.fit_anchor_weight before raising it.
MARKET_ANCHOR_WEIGHT=0.35
ADAPTIVE_ANCHOR=true

# --- reference exchanges --------------------------------------------------
EXCHANGES=binance,coinbase,kraken,okx,bybit
# Below this the composite price is distrusted and trading pauses. Never 1:
# with one source there is nothing to cross-check against.
MIN_HEALTHY_EXCHANGES=2

# --- resolution oracle ----------------------------------------------------
# These markets settle on a Chainlink data stream. 'composite' uses the
# exchange composite as a proxy and prices the resulting basis risk.
RESOLUTION_ORACLE=composite
ORACLE_BASIS_BPS=2.0

# --- risk ------------------------------------------------------------------
BANKROLL=1000
MAX_STAKE_PER_TRADE=25
MAX_STAKE_FRACTION=0.02
KELLY_FRACTION=0.25
MAX_PORTFOLIO_EXPOSURE=200
MAX_SIMULTANEOUS_POSITIONS=6
MAX_DAILY_LOSS=100
MAX_SESSION_LOSS=150
MAX_CONSECUTIVE_LOSSES=8
MAX_DRAWDOWN=0.25

# --- execution -------------------------------------------------------------
# Makers pay no fee at all, so at a one-tick spread the same view is worth
# roughly twice as much passively as aggressively.
EXECUTION_STYLE=maker_then_taker
MAKER_WAIT_SECONDS=20
PAPER_LATENCY_MS=250
PAPER_MAKER_FILL_RATIO=0.45

# --- models ----------------------------------------------------------------
ML_ENABLED=true
CALIBRATION_METHOD=isotonic
ADAPTIVE_WEIGHTS=true

# --- storage and logging --------------------------------------------------
DATABASE_URL=sqlite:///data/pmbot.db
# This is your training data. Leave it on.
RECORD_TRAINING_DATA=true
SNAPSHOT_INTERVAL_SECONDS=1
LOG_LEVEL=INFO
LOG_JSON=true

# --- alerts (optional) ----------------------------------------------------
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
