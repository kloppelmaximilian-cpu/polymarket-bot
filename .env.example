# Automated Opportunity Center — configuration
# Copy to .env (`pnpm setup` does this and generates API_TOKEN). Never commit .env.
# PAPER = DEFAULT. LIVE = DISABLED. This build contains no live executor at all.

NODE_ENV=development
LOG_LEVEL=info

# ---- Database --------------------------------------------------------------
# PostgreSQL (docker compose up -d postgres):
DATABASE_URL=postgres://aoc:aoc@127.0.0.1:5432/aoc
# Or embedded Postgres without Docker (single process, used by `pnpm dev:embedded`):
# DATABASE_URL=pglite://.data/pglite
# Integration tests against a real PostgreSQL (optional; default is in-memory PGlite):
# TEST_DATABASE_URL=postgres://aoc:aoc@127.0.0.1:5432/postgres

# ---- API -------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
# Bearer token for the API (>= 16 chars; >= 24 required with NODE_ENV=production).
# The web dashboard sends it server-side; it never reaches the browser.
API_TOKEN=
API_RATE_LIMIT_PER_MINUTE=600
WEB_ORIGIN=http://localhost:3000

# ---- Web dashboard ---------------------------------------------------------
# Where the dashboard's server reaches the API.
API_URL=http://127.0.0.1:4000
# Optional HTTP basic auth in front of the dashboard (set both to enable).
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASSWORD=

# ---- Safety (live trading) -------------------------------------------------
# Live trading is NOT implemented. These flags exist so the gate can explain
# what would be required; even with all of them set, the gate stays closed.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION=
LIVE_CAPITAL_CAP_USD=0

# ---- Paper money (virtual) -------------------------------------------------
PAPER_TOTAL_CAPITAL_USD=10000
PAPER_DEFAULT_ALLOCATION_USD=1000
# Separate budget pool for simulated business operations.
BUSINESS_SIM_BUDGET_USD=20000
PAPER_TICK_SECONDS=60
# Simulated business days per paper tick (1 = one day per tick).
BUSINESS_PAPER_DAYS_PER_TICK=1

# ---- Market data (public endpoints only, no keys needed) -------------------
MARKET_DATA_ENABLED=true
MARKET_DATA_WEBSOCKETS=true
DATA_STALE_AFTER_MS=120000
HTTP_TIMEOUT_MS=10000

# ---- Research --------------------------------------------------------------
RESEARCH_MONITOR_ENABLED=true
# Optional: raises the GitHub search rate limit.
GITHUB_TOKEN=
# Optional: lets the idea generator use Claude instead of the built-in catalogue.
ANTHROPIC_API_KEY=
IDEA_GENERATOR_LLM_ENABLED=false
LLM_MODEL=claude-opus-5-5

# ---- Workers ---------------------------------------------------------------
SCHEDULER_ENABLED=true
# Run the worker inside the API process (automatic with pglite://).
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
JOB_LEASE_MS=300000

# ---- Notifications (optional webhook) --------------------------------------
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=generic
